APP_NAME=langgraph-workflows
APP_ENV=dev
API_KEY=change-me-in-production
LOG_LEVEL=INFO

# dashscope | openai_compatible | hospital | mock
LLM_PROVIDER=mock
LLM_MODEL=qwen3-32b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:8000/v1

# 医院内部算力（POST .../v1/chat/completions，鉴权头 X-API-KEY）
HOSPITAL_LLM_BASE_URL=http://172.28.24.104:30020/endpoint/AFTYb_g8w89_28ZWS/v1
HOSPITAL_LLM_API_KEY=0fdc3ad71bfb5a97989a2efdf959d7e7
HOSPITAL_LLM_MODEL=Qwen3-32B

REDIS_URL=redis://localhost:6379/0
TASK_TTL_SECONDS=86400
WORKFLOW_TIMEOUT_SECONDS=600
WORKER_POLL_INTERVAL_SECONDS=1.0

# 智能病案编码知识库（实际端口 8090，不是文档默认 8000）
KB_BASE_URL=http://127.0.0.1:8090
KB_TOP_K=4
KB_CANDIDATE_K=80
KB_TIMEOUT_SECONDS=30
KB_ENABLED=true

# optional request body redaction in logs
LOG_REDACT_INPUT=true
